# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: server-only, used by the IBKR sync job. NEVER ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Interactive Brokers — Client Portal Web API, OAuth 1.0a (self-service portal)
# Set these up at: https://www.interactivebrokers.com/campus/ibkr-api-page/oauth-1-0a-extended/
IBKR_CONSUMER_KEY=
IBKR_ACCESS_TOKEN=
IBKR_ACCESS_TOKEN_SECRET=
# Private keys: paste full PEM (use \n escapes) OR base64-encode the PEM. The loader handles both.
IBKR_ENCRYPTION_KEY=
IBKR_SIGNATURE_KEY=
# Diffie-Hellman prime (hex), from the portal dhparam. Generator is almost always 2.
IBKR_DH_PRIME=
IBKR_DH_GENERATOR=2
# Optional: pin a specific account; otherwise the first account is used.
IBKR_ACCOUNT_ID=
# 'limited_poa' for live, 'test_realm' when testing with the TESTCONS consumer key.
IBKR_REALM=limited_poa
