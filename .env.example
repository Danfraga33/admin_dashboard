# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: server-only, used by the portfolio sync job. NEVER ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Sharesight User API (OAuth2). Request an API account from support@sharesight.com,
# then find Client ID / Secret under Account > Sharesight API. See docs/plan.md §2.
# Client-credentials grant (own account) needs your user linked to the API consumer app.
SHARESIGHT_CLIENT_ID=
SHARESIGHT_CLIENT_SECRET=
# Base: https://api.sharesight.com/api/v2 (stable) or /api/v3 (beta).
SHARESIGHT_API_BASE=https://api.sharesight.com/api/v2
# Token endpoint host (OAuth2). Tokens last 30 min — the client refreshes them.
SHARESIGHT_OAUTH_BASE=https://api.sharesight.com

# Feature flags — set "true" to reveal the page; anything else shows "In Construction".
SHOW_VENTURES=false
