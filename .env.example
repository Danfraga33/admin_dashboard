# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: server-only, used by the IBKR sync job. NEVER ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Interactive Brokers — individual self-access via the Client Portal Gateway.
# The gateway (Java, run locally or via IBeam/Docker on an always-on box) holds the
# authenticated session after a browser login. The sync job calls it directly.
# Gateway base URL. Default https://localhost:5000 when running the gateway locally.
IBKR_GATEWAY_URL=https://localhost:5000
# Account id (e.g. U8770342). Leave blank to use the first account the gateway returns.
IBKR_ACCOUNT_ID=
# Dev only: set to 1 to make /investments fetch live from the gateway (skips Supabase).
IBKR_LIVE_IN_DEV=
