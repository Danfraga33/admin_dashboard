# --- ElevenLabs voice (Atlas briefing) --------------------------------------
# Without these, the briefing falls back to the built-in Windows SAPI voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional overrides (sane defaults in jarvis.py):
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# --- Live Atlas briefing fetch ----------------------------------------------
# The dashboard's localhost TTS endpoint. Sidecar GETs the briefing summary
# here on double clap and speaks it. Point at your dev server (or prod URL).
ATLAS_BRIEFING_URL=http://localhost:5173/api/briefing/tts
# Shared secret — must match SIDECAR_TTS_SECRET in the dashboard's .env.local.
ATLAS_BRIEFING_SECRET=
# Spoken if the dashboard is unreachable.
ATLAS_BRIEFING_FALLBACK=Welcome home sir. Briefing is offline.

# --- Ritual targets ---------------------------------------------------------
# Spotify desktop track URI (spotify:track:... auto-plays; https link does not).
SONG_URI=spotify:track:0cgODPSGPfVKvJ3ZarsK70
# Windows mixer volume for Spotify when the track starts (0..1, or 0..100).
# Negative leaves whatever volume Spotify already had.
JARVIS_SONG_VOLUME=0.75
# Brave site opened on double clap (your admin dashboard by default).
TRACTION_SITE_URL=http://localhost:5173/
# Which monitor (1-based, left-to-right) the Brave window snaps to.
TRACTION_CHROME_MONITOR=1
# TradingView UWP app id (Store install). Leave default unless yours differs.
# TRADINGVIEW_APP_ID=31178TradingViewInc.TradingView_q4jpyh43s5mv6!TradingView.Desktop

# --- Mic tuning (optional) --------------------------------------------------
# Auto-pick can grab "Stereo Mix" (system loopback, not a real mic). Force your
# input by index or name substring. A BT headset mic only works in Hands-Free
# (HFP) mode — set the headset to "Headset" in Windows Sound so its mic is live;
# after the ritual fires the sidecar releases it and it flips back to A2DP hi-fi.
# JARVIS_INPUT_DEVICE=MOMENTUM
# MIN_RMS=0.008             # clap floor; lower for quiet BT mics (measured ~0.016)
# SPIKE_RATIO=12            # clap must be this * the noise floor
# JARVIS_VOICE_GAIN=0.6     # playback volume for the spoken briefing (0..1)
